NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/DATABASE?retryWrites=true&w=majority
FRONTEND_URL=https://your-vercel-domain.vercel.app
PUBLIC_API_URL=https://your-backend.example.com
JWT_SECRET=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
COOKIE_SECURE=true
OWNER_EMAIL=owner@example.com
OWNER_PASSWORD=CHANGE_THIS_IMMEDIATELY
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:owner@example.com
MAX_UPLOAD_MB=8

# Push worker tuning (optional)
PUSH_WORKER_POLL_MS=30000
PUSH_WORKER_CONCURRENCY=10
PUSH_WORKER_CLAIM_TIMEOUT_MS=600000

# Razorpay ad booking payments
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Admin password-reset OTP email (preferred on Render Free; uses HTTPS, not SMTP ports)
RESEND_API_KEY=
RESEND_FROM=Awaaz Rajasthan <onboarding@resend.dev>
