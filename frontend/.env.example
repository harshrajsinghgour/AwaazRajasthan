# Frontend environment
# Public URL of the Node/Express backend, without a trailing slash.
VITE_API_URL=https://your-backend.example.com

# Optional e-paper URL.
VITE_E_PAPER_URL=/epaper

# Optional Web Push VAPID public key.
VITE_VAPID_PUBLIC_KEY=

# Optional official live-TV / live-stream URL shown in the Live Desk.
VITE_LIVE_TV_URL=