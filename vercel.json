{
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin/index.html"
    },
    {
      "source": "/api/:path*",
      "destination": "https://awaazrajasthan.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://awaazrajasthan.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/news/:path*",
      "destination": "/api/share?slug=:path*"
    },
    {
      "source": "/n/:path*",
      "destination": "/api/n/:path*"
    },
    {
      "source": "/s/:path*",
      "destination": "/api/s/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/news",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "news"
        }
      ]
    }
  ]
}
