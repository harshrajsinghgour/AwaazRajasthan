{
  "framework": "nextjs",
  "buildCommand": "cd frontend && npm run build",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://awaazrajasthan.onrender.com/api/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://awaazrajasthan.onrender.com/api/sitemap.xml"
    },
    {
      "source": "/sitemap-news.xml",
      "destination": "https://awaazrajasthan.onrender.com/api/sitemap-news.xml"
    },
    {
      "source": "/rss.xml",
      "destination": "https://awaazrajasthan.onrender.com/api/rss.xml"
    }
  ],
  "headers": [
    {
      "source": "/api/news",
      "headers": [
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Vercel-CDN-Cache-Control",
          "value": "public, s-maxage=30, stale-while-revalidate=3600, stale-if-error=86400"
        },
        {
          "key": "Vercel-Cache-Tag",
          "value": "news"
        }
      ]
    }
  ]
}
